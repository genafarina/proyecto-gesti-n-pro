# Public Supabase configuration used by the browser bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# The same public values are read by server-side rendering and server functions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Do not add a service-role key unless a future server-only feature requires it.
# Never prefix server secrets with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
